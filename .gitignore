# Build artifacts and venv
__pycache__/
*.pyc
.venv/
env/

# Training and inference outputs
runs/
*.pt
*.npy


# v2 working data dirs (keep paths, ignore contents)
data/raw/
data/manifest*.jsonl
data/v2_corpus*/

# Local OS clutter
.DS_Store


# explorer sample cache
evals/dataset_samples/

# Eval prompt sets: site uploads and corpus excerpts. Third-party music
# that happens to be useful as a test fixture is still third-party music,
# and the filenames alone name artists and tracks. Kept on disk, never
# committed. Rebuild with `python -m midigenai.make_prompt_set`.
evals/prompts/
evals/scorecards/*.rows.json

# Generated eval artifacts (MIDI, audio, app logs) — derived data, not source
evals/prompts_heldout/
evals/prompts_val/
evals/progress_v4/
evals/labeling*/pairs/
# hub manifests point at local pair dirs; they travel with the pairs, not in git
evals/labeling*/manifest.jsonl
evals/**/*.log
evals/*.log
evals/**/*.mp3
evals/**/*.wav
evals/samples*/

# corpus quality labeling: excerpt MIDIs are rebuilt from path+window on demand
evals/quality/excerpts/

# secrets
.env
.env.*

# ceiling re-labeling: timelines are rebuilt from the pair MIDI on demand
evals/ceiling/timeline_cache/

# local corpora and scratch outputs: multi-GB, rebuilt from ~/midigenai_data
lmd_full_txt/
ableton_live_txt/
generated/
tests/tmp/
midigenai.egg-info/
.claude/
evals/autolabel*/pairs/

# per-layer probe feature caches: hundreds of MB, rebuilt from pairs + checkpoint
evals/reward/cache/

# your own Ableton clips, extracted as prompts: personal material, rebuilt from ~/Music/Ableton
evals/prompts_ableton/

# weighted RL prompt pools: symlinks into the held-out seed sets
evals/prompts_pool*/

# the user's own Ableton material: seeds and pairs built on it stay local
evals/prompts_ableton*/
evals/pairs_ableton*/

# judge outputs: per-pair results and auto-labels stay local; evals/reward/judge_summary.json holds the numbers
evals/reward/judge_*.json
!evals/reward/judge_*_final.json
!evals/reward/judge_summary.json
evals/reward/rubric_battery/
evals/reward/autolabel_*_labels*.jsonl
evals/reward/*_partial.jsonl
evals/prompts_fma/
